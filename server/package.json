{
  "name": "tical-signing",
  "private": true,
  "type": "module",
  "description": "Signs Tical's Wallet passes. It only ever sees the SHA-256 digest of a pass's manifest.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev-vars": "node scripts/dev-vars.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260925.1": true
  }
}
